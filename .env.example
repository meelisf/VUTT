# VUTT keskkonnamuutujad — ÜKS nimi ühe seade kohta (ADR 0021).
#
# Kopeeri `.env`-iks ja täida väärtused. Eraldi `.env.local` faili EI OLE —
# kaks faili tähendasid varem, et sama väärtus kandis eri failides eri nime.
# Aegunud nimi peatab backendi käivituse veateatega, mis nimetab õige nime
# (vt server/config.py `_LEGACY_ENV_NAMES`). Vaikset fallbackit ei ole.
#
# Süsteemi keskkonnamuutuja on `.env`-ist ülimuslik — Docker ja tootmine
# annavad seaded sealtkaudu, `.env` on lokaalse arenduse mugavus.

# --- Keskkond -------------------------------------------------------------
# `production` aktiveerib startup-kontrolli arendusvaikeväärtuste vastu.
# Arenduses jäta määramata (= dev).
VUTT_ENV=dev

# --- Meilisearch ----------------------------------------------------------
# Dockeris on host `meilisearch`, lokaalselt 127.0.0.1.
MEILI_URL=http://127.0.0.1:7700

# Täisõigustega võti. Backend kasutab ainult seda; EI TOHI jõuda frontendi.
MEILI_MASTER_KEY=

# Otsingu-õigustega võti + selle UID. Backend teeb neist kliendile
# runtime'is tenant-tokeni (`meilisearch_ops.create_tenant_token`) —
# frontend ise ühtki Meili võtit ei loe ega vaja.
MEILI_SEARCH_KEY=
MEILI_SEARCH_KEY_UID=

# --- Saladused ------------------------------------------------------------
# Pildi-URL-ide HMAC-allkiri; image_server ja main.py jagavad sama väärtust.
# Arenduses võib jääda tühjaks — tühi väärtus langeb tagasi
# arendusvaikeväärtusele ja lokaalselt allkirjastab ning verifitseerib sama
# protsess. KOHUSTUSLIK ainult tootmises: `VUTT_ENV=production` korral keeldub
# `check_production_secrets()` vaikeväärtusega käivitumast.
IMAGE_TOKEN_SECRET=

# --- Upload / OCR-server --------------------------------------------------
UPLOAD_ENABLED=false
OCR_SERVER_HOST=
OCR_SERVER_USER=
OCR_SERVER_PATH=

# --- Gemini (teine OCR-pakkuja, ainult superadmin) ------------------------
# Tühi võti = funktsioon välja lülitatud (kehtiv seisund, mitte viga).
# NÕUE: mitteavalikku materjali tohib saata AINULT billing-enabled (Paid Tier)
# projekti võtmega — tasuta tasandil kasutatakse sisu Google'i toodete
# parandamiseks. See on `store=false`-ist eraldi ja sellest sõltumatu nõue.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.8-flash
# low | medium | high. Mudeli enda vaikeväärtus oleks `medium`; OCR on
# tajuülesanne, mitte arutlusülesanne, ja thinking-tokenid on väljundikulu.
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_INFLIGHT_REQUESTS=4
GEMINI_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT=120
GEMINI_MAX_REQUEST_BYTES=15728640
GEMINI_MAX_PROMPT_BYTES=8192
GEMINI_MAX_FEW_SHOT=3

# --- Andmete asukoht ------------------------------------------------------
# Docker seab selle ise (/data). Lokaalselt jäta määramata → repo `data/`.
#VUTT_DATA_DIR=

# --- Ainult testidele -----------------------------------------------------
# Suunab `.env` lugemise mujale. Tootmises ega arenduses ei seata.
#VUTT_DOTENV_DIR=

# --- MCP-server (eraldi protsess) ----------------------------------------
# `vutt-mcp` paigaldatakse pipx-iga globaalselt ega loe seda faili — võti
# antakse kliendi MCP-konfis. Prefiks väldib kollisiooni kasutaja shellis
# oleva MEILI_SEARCH_KEY-ga. Väärtus on sama mis MEILI_SEARCH_KEY.
# VUTT_MEILI_SEARCH_KEY=
